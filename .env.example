# Supabase Credentials (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connections (Used for Prisma migrations & local CLI)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# AI Services
NEXT_PUBLIC_OPENAI_API_KEY=your-openai-api-key

# Location & Geocoding
NEXT_PUBLIC_IPGEO_API_KEY=your-ip-geo-key

# Nutrition & Recipe APIs
EDAMAM_APP_ID=your-edamam-app-id
EDAMAM_APP_KEY=your-edamam-app-key

# Transactional Email (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@vicalary.com

# Open Banking Credentials
# Plaid (US/Canada)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=production

# TrueLayer (UK/Europe)
TRUELAYER_CLIENT_ID=your-truelayer-client-id
TRUELAYER_CLIENT_SECRET=your-truelayer-client-secret

# Brankas (Asia)
BRANKAS_API_KEY=your-brankas-api-key
